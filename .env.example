# ── Frontend build-time vars (NEXT_PUBLIC_ baked into the image) ──
# Browser calls the backend directly, so this stays localhost unless you're
# deploying behind a reverse proxy with a real domain.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Backend runtime vars (set in backend/.env) ────────────────────
# These are read from ./backend/.env via env_file in docker-compose.
# Copy backend/.env.example → backend/.env and fill in values.
